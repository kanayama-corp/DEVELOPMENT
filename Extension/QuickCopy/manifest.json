{
  "manifest_version": 3,
  "name": "QuickCopy",
  "version": "1.1.1",
  "description": "Double-click, triple-click, or drag-select text to instantly copy it to the clipboard. Works on Google Sheets.",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {},
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
