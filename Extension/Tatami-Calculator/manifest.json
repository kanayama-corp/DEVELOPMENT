{
  "manifest_version": 3,
  "name": "畳計算機",
  "version": "1.2",
  "description": "mm入力で畳サイズを計算します",
  "action": {
    "default_popup": "popup.html",
    "default_title": "畳計算機"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "畳計算機を開く"
    }
  },
  "permissions": ["storage"]
}
